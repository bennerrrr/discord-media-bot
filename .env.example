# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required
DISCORD_TOKEN=your_discord_bot_token_here

# Optional — how long to stay in a voice channel with nothing playing
# before leaving. Default: 300 seconds (5 min).
IDLE_TIMEOUT_SECONDS=300

# Optional — only needed if you want Jellyfin support
JELLYFIN_BASE_URL=http://your-jellyfin-host:8096
JELLYFIN_API_KEY=your_jellyfin_api_key_here
JELLYFIN_USER_ID=your_jellyfin_user_id_here
